# Copy to .env and change every secret.  `openssl rand -hex 32` for JWT_SECRET.
POSTGRES_USER=carbonscope
POSTGRES_PASSWORD=change-me-db-password
# Local (non-docker) dev only; docker-compose overrides DATABASE_URL/REDIS_URL.
DATABASE_URL=postgresql+psycopg://carbonscope:change-me-db-password@localhost:5432/carbonscope
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-64-hex-chars
ACCESS_MINUTES=15
REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
# Bootstrap admin (created by `python -m backend.app.seed` if absent). Admins cannot self-register.
ADMIN_EMAIL=admin@carbonscope.in
ADMIN_PASSWORD=change-me-admin-password
# CARBONSCOPE_SKIP_TRAIN=1
